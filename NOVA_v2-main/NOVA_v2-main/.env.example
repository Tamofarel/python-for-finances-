# NOVA configuration. Copy to ".env" (same folder) and adjust. Placeholders only — never commit .env.

# --- Network exposure ---------------------------------------------------------
# 127.0.0.1 keeps NOVA reachable from this computer only. Binding to 0.0.0.0 exposes it to your
# network: only do that behind HTTPS and set NOVA_COOKIE_SECURE=true.
NOVA_HOST=127.0.0.1
NOVA_PORT=8000
NOVA_COOKIE_SECURE=false
NOVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NOVA_SESSION_TTL_HOURS=72

# --- Storage ------------------------------------------------------------------
# Database, workspaces and logs live here (default: ./data next to this file).
# NOVA_DATA_DIR=C:\Users\you\NOVA-data
# Extra folders that projects may use as workspaces (';'-separated). Leave empty to only allow
# workspaces inside NOVA_DATA_DIR\workspaces.
NOVA_ALLOWED_WORKSPACE_ROOTS=
NOVA_MAX_FILE_BYTES=1000000

# --- AI providers -------------------------------------------------------------
# Which provider new conversations use until you pick one in the UI: ollama | anthropic
NOVA_DEFAULT_PROVIDER=ollama

# Ollama (local, optional). NOVA never downloads models; run `ollama pull llama3.2` yourself.
NOVA_OLLAMA_BASE_URL=http://127.0.0.1:11434
NOVA_OLLAMA_MODEL=llama3.2

# Anthropic (cloud, optional). The key stays on the backend; it is never sent to the browser.
NOVA_ANTHROPIC_API_KEY=
NOVA_ANTHROPIC_MODEL=claude-sonnet-5-5
NOVA_ANTHROPIC_MAX_TOKENS=4096

# --- Research (optional) --------------------------------------------------------
# none | searxng   (SearXNG must have the JSON output format enabled)
NOVA_RESEARCH_PROVIDER=none
NOVA_SEARXNG_URL=

# --- Tool execution -------------------------------------------------------------
# ';'-separated allowlisted command prefixes. A command runs only if its arguments start with one.
NOVA_COMMAND_ALLOWLIST=python -m pytest;pytest;python -m unittest;npm test;npm run test;npm run build;npm run lint;git status;git diff;git log;ruff check
NOVA_COMMAND_TIMEOUT_SECONDS=300
# --- Actions (see docs/ACTIONS.md) ----------------------------------------------------
# Lets NOVA act on this PC when you ask (approved apps, allowed websites, project files, media keys, starting Spotify).
# Spotify playback through your connected account works without it (NOVA then never starts the Spotify app).
# Separate from the command runner; never runs shell commands. Needs a model that can call tools (llama3.2, mistral, Claude).
NOVA_DESKTOP_CONTROL_ENABLED=false
# Spotify Developer app client ID (not a password or client secret). Configure the callback using your port:
# http://127.0.0.1:8000/api/spotify/callback (or change 8000 to NOVA_PORT).
NOVA_SPOTIFY_CLIENT_ID=
# Extra apps NOVA may open, ';'-separated: name=C:\path\App.exe|app.exe|alias1,alias2
# Or use a registered URI scheme: name=spotify:|spotify.exe|music player. No command arguments are accepted.
# Built in: Spotify, Calculator, Settings, Notepad/Notes, File Explorer, Microsoft Word/MS Word, VS Code.
NOVA_DESKTOP_APPS=
# Websites NOVA may open (a host also allows its subdomains). Leave unset for the default list.
# NOVA_BROWSER_ALLOWED_HOSTS=localhost,127.0.0.1,google.com,youtube.com,github.com,stackoverflow.com,wikipedia.org,developer.mozilla.org,docs.python.org,open.spotify.com

# --- Smart home: Home Assistant (optional) ----------------------------------------------
# Only the listed entities are reachable. Locks, covers, climate, water heaters, valves and (by default) switches are
# safety-critical: NOVA queues them for your approval on screen. Mark a harmless switch with =reversible.
NOVA_HOME_ASSISTANT_URL=
NOVA_HOME_ASSISTANT_TOKEN=
NOVA_HOME_ASSISTANT_ENTITIES=

NOVA_LOG_LEVEL=INFO

# --- Voice (see docs/VOICE.md) ----------------------------------------------------
# The wake phrase is detected locally by the backend. Microphone audio is accepted only from this computer
# unless NOVA_VOICE_ALLOW_REMOTE=true (use HTTPS if you do that). Audio is never stored.
NOVA_VOICE_ENABLED=true
NOVA_VOICE_ALLOW_REMOTE=false
# Optional: folder of an unpacked Vosk model for better offline transcription (pip install -r requirements-voice-extra.txt)
NOVA_VOSK_MODEL_PATH=
# Optional language-specific Vosk folders separated by |; these override NOVA_VOSK_MODEL_PATH by language.
# Example: NOVA_VOSK_MODEL_PATHS=en-US=C:\models\vosk-en|fr-FR=C:\models\vosk-fr
NOVA_VOSK_MODEL_PATHS=
NOVA_VOICE_MAX_UTTERANCE_SECONDS=20

# --- Images -------------------------------------------------------------------------
NOVA_MAX_IMAGE_BYTES=5000000
